#usda 1.0
(
    defaultPrim = "Root"
    metersPerUnit = 1
    upAxis = "Y"
    doc = "Platzhalter-Asset fuer Monster 03. Wird durch das fertige Blender-Export-USDZ ersetzt."
)

def Xform "Root"
{
    def Sphere "MonsterMesh" (
        active = true
    )
    {
        double radius = 0.08
        quatf xformOp:orient = (1, 0, 0, 0)
        float3 xformOp:scale = (1, 1, 1)
        float3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }
}
